{
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run *)",
      "Bash(docker compose*)",
      "Bash(bash scripts/verify.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git worktree*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(SKIP_GATES=* bash scripts/verify.sh*)",
      "Edit(.claude/handoffs/**)",
      "Write(.claude/handoffs/**)",
      "Edit(ops/change-state/**)",
      "Write(ops/change-state/**)",
      "Edit(.claude/worktrees/**)",
      "Write(.claude/worktrees/**)",
      "Edit(openspec/changes/**)",
      "Write(openspec/changes/**)"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Bash(aws *)",
      "Bash(terraform apply*)",
      "Bash(cdk deploy*)",
      "Bash(kubectl *)",
      "Bash(docker context *)",
      "Bash(git push*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-merge-to-main.sh\""
          }
        ]
      }
    ]
  }
}
